FROM oraclelinux:8

LABEL maintainer="Oracle DBA Ansible Team"
LABEL description="Oracle Managed Node for Ansible Lab - Chapter 10 (Package Provisioning)"

# 1. 시스템 기본 패키지 및 SSH, Python, Sudo 설치
RUN dnf install -y oracle-epel-release-el8 && \
    dnf config-manager --set-enabled ol8_developer_EPEL && \
    dnf install -y \
        openssh-server \
        openssh-clients \
        python39 \
        sudo \
        tar \
        gzip \
        vim-enhanced \
        which \
        bind-utils \
        iproute \
        procps-ng \
        passwd \
        hostname && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# 2. Oracle 관련 그룹 생성
RUN groupadd -g 54321 oinstall && \
    groupadd -g 54322 dba && \
    groupadd -g 54327 asmdba || true && \
    groupadd -g 54328 asmoper || true && \
    groupadd -g 54329 asmadmin || true && \
    groupadd -g 54330 racdba || true

# 3. oracle 사용자 생성 및 sudo 무암호 권한 설정
RUN useradd -u 54321 -g oinstall -G dba,asmadmin,asmdba,racdba,wheel -m -s /bin/bash oracle && \
    echo "oracle:oracle" | chpasswd && \
    echo "oracle ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/oracle && \
    chmod 0440 /etc/sudoers.d/oracle

# 4. SSHD 설정 및 호스트 키 생성
RUN ssh-keygen -A && \
    mkdir -p /var/run/sshd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config

# 5. Oracle 디렉터리 기반 구조 생성
RUN mkdir -p /u01/app/oracle \
             /reports && \
    chown -R oracle:oinstall /u01 /reports && \
    chmod -R 775 /u01 /reports

# 6. 엔트리포인트 배포
COPY entrypoint-node.sh /usr/local/bin/entrypoint-node.sh
RUN chmod +x /usr/local/bin/entrypoint-node.sh

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/entrypoint-node.sh"]
