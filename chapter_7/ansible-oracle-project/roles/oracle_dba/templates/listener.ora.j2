# Master Project Listener Configuration (Role: oracle_dba)
# Environment: {{ env_name | default('dev') | upper }} | Host: {{ ansible_hostname }}

LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS =
        (PROTOCOL = TCP)
        (HOST = {{ ansible_hostname }})
        (PORT = {{ listener_port }})
      )
    )
  )

SID_LIST_LISTENER =
  (SID_LIST =
    (SID_DESC =
      (GLOBAL_DBNAME = {{ db_name }})
      (ORACLE_HOME = {{ oracle_home }})
      (SID_NAME = {{ sid }})
    )
  )

