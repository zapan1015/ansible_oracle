# ========================================================
# Oracle RAC 19c Container Environment Template
# ========================================================

# Database & Cluster Config
DB_NAME=ORCL
DB_UNIQUE_NAME=ORCL_LAB
ORACLE_VERSION=19.3.0
CLUSTER_NAME=rac-cluster-lab
DOMAIN=lab.local

# Storage & ASM Config
ASM_DISCOVERY_DIR=/dev/asm-disk*
ASM_DISKGROUP=DATA
ASM_RECOVERY_DISKGROUP=RECO

# Network Config
SCAN_NAME=rac-scan.lab.local
SCAN_PORT=1521
DNS_SERVERS=192.168.1.1

# Node 1 Config
NODE1_NAME=racnode1
NODE1_IP=192.168.1.101
NODE1_VIP=192.168.1.111
NODE1_PRIV_IP=192.168.17.101
NODE1_SID=ORCL1

# Node 2 Config
NODE2_NAME=racnode2
NODE2_IP=192.168.1.102
NODE2_VIP=192.168.1.112
NODE2_PRIV_IP=192.168.17.102
NODE2_SID=ORCL2
