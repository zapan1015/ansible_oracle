# ====================================================================
# Oracle TNSNAMES Configuration Generated by Ansible
# Generated for: {{ inventory_hostname }} (Env: {{ oracle_env | upper }})
# Total Defined DBs: {{ all_databases | length }}
# ====================================================================

{% for db in all_databases %}
{% if db.is_active | default(true) %}
# [Entry {{ loop.index }}] {{ db.name | upper }}{% if loop.first %} (Primary Target){% endif %}

{{ db.name | upper }} =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ db.host }})(PORT = {{ db.port }}))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ db.service_name | lower }})
    )
  )

{% endif %}
{% endfor %}
