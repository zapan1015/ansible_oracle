# ====================================================================
# Oracle Listener Configuration Generated by Ansible (Jinja2)
# Environment: {{ oracle_env | upper }}
# Managed Host: {{ inventory_hostname }}
# ====================================================================

LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ db_host }})(PORT = {{ listener_port }}))
    )
  )

{# 조건문: ADR 활성화 여부 #}
{% if enable_adr | default(false) %}
ADR_BASE_LISTENER = {{ adr_base }}
{% else %}
# ADR is disabled for {{ oracle_env }} environment
{% endif %}

{# 조건문: 환경별 로그 레벨 분기 #}
{% if oracle_env == 'prod' %}
LOG_LEVEL_LISTENER = ERROR
{% elif oracle_env == 'test' %}
LOG_LEVEL_LISTENER = INFO
{% else %}
LOG_LEVEL_LISTENER = DEBUG
{% endif %}
